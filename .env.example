# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored so secrets never reach the repo.

# --- UI target ---
UI_BASE_URL=https://www.saucedemo.com

# --- API target ---
API_BASE_URL=https://restful-booker.herokuapp.com

# --- restful-booker auth credentials (public demo defaults) ---
API_USERNAME=admin
API_PASSWORD=password123

# --- Selenium execution mode ---
#   local -> use a locally-installed Chrome via webdriver-manager
#   grid  -> connect to a Selenium Grid (Docker) at SELENIUM_REMOTE_URL
RUN_MODE=local
SELENIUM_REMOTE_URL=http://localhost:4444/wd/hub

# --- Browser: chrome or firefox ---
BROWSER=chrome

# --- Headless? true in CI/Docker, false to watch it run locally ---
HEADLESS=true
